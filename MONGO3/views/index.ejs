<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Whatsapp Chats</h1>
 
   <form> 
    <button>
        Add new chat
    </button>
   </form>

   <% for(let chat of chats) { %>
    <div class="chat">
        <div class="name">
            <h2> From: <%= chat.from %></h2>
        </div>
          <div class = "to">
            <h3> To: <%= chat.to %></h3>
        </div>
    
        <div class="message">
            <p class="msg"><%= chat.msg %></p>
        </div>
    </div>
   <% } %>   
    
</body>
</html>