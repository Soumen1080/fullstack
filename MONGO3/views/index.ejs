<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
</head>
<body>
    <h1>Whatsapp Chats</h1>

   <% for(let chat of chats) { %>
        <div class="name">
            <h2> From: <%= chat.from %></h2>
        </div>
          <div class = "to">
            <h3> To: <%= chat.to %></h3>
        </div>
    
        <div class="message">
            <p message ><%= chat.msg %></p>
        </div>
   <% } %>   
    
</body>
</html>